#import <Foundation/Foundation.h>

extern "C" {
    #include <lua.h>
    #include <lauxlib.h>
    #include <lualib.h>
}

// Đoạn mã Lua của bạn được nhúng thẳng vào đây dưới dạng chuỗi thô
const char* embeddedLuaScript = R"(
local LocalPlayer = "LocalPlayer"
local MultiTable = "SicBoMultiplayerSceneTable3D"
local MultiPlayer = "SicBoMultiplayerScenePlayer3D"
local OfflineTable = "SicBoOfflineSicBoTable3D"
local Dealer = "SicBoOfflineSceneDealer3D"

local state = {
    balance = false, allIn = false, noLose = false, testing = false,
    comb = false, anyTrible = false, trible = false, double = false,
    balanceValue = 999999999, status = "Sẵn sàng"
}

local function setPatch(className, methodName, enable, valType, value)
    local success, err = pcall(function()
        if enable then
            if valType == "int" then gg.il2cpp.patch(className, methodName, value)
            elseif valType == "bool" then gg.il2cpp.patch(className, methodName, value)
            elseif valType == "nop" then gg.il2cpp.nop(className, methodName) end
        else
            gg.il2cpp.restore(className, methodName)
        end
    end)
    return success, err
end

local function applyBalanceGate()
    local enabled = state.balance or state.allIn
    setPatch(LocalPlayer, "get_balance", enabled, "int", state.balanceValue)
    setPatch(MultiTable, "GetUserbalance", enabled, "int", state.balanceValue)
    if enabled then
        state.status = "Vốn cược: " .. state.balanceValue .. " (Đã kích hoạt)"
    else
        state.status = "Balance/All In: Đã tắt và khôi phục"
    end
end

function MainMenu()
    local menuList = {
        (state.balance and "[✔] " or "[ ] ") .. "Balance 999999999",
        (state.allIn and "[✔] " or "[ ] ") .. "Cho phép All In vốn",
        (state.noLose and "[✔] " or "[ ] ") .. "No Lose Line (Multiplayer)",
        (state.testing and "[✔] " or "[ ] ") .. "Testing Mode (Offline)",
        (state.comb and "[✔] " or "[ ] ") .. "Force Comb",
        (state.anyTrible and "[✔] " or "[ ] ") .. "Force Any Triple",
        (state.trible and "[✔] " or "[ ] ") .. "Force Triple",
        (state.double and "[✔] " or "[ ] ") .. "Force Double",
        "--- TRẠNG THÁI: " .. state.status .. " ---",
        "Thoát"
    }

    local choix = gg.choice(menuList, nil, "SicBo Runtime Mod - iGameGod")
    if choix == nil then return end
    
    if choix == 1 then state.balance = not state.balance; applyBalanceGate()
    elseif choix == 2 then state.allIn = not state.allIn; applyBalanceGate()
    elseif choix == 3 then
        state.noLose = not state.noLose
        setPatch(MultiPlayer, "loseLine", state.noLose, "nop", nil)
        state.status = state.noLose and "No Lose Line ON" or "No Lose Line OFF"
    elseif choix == 4 then
        state.testing = not state.testing
        setPatch(OfflineTable, "istesting", state.testing, "bool", true)
        state.status = state.testing and "Testing Mode ON" or "Testing Mode OFF"
    elseif choix == 5 then
        state.comb = not state.comb
        setPatch(Dealer, "isComb", state.comb, "bool", true)
        state.status = "Force Comb: " .. tostring(state.comb)
    elseif choix == 6 then
        state.anyTrible = not state.anyTrible
        setPatch(Dealer, "isAnyTrible", state.anyTrible, "bool", true)
        state.status = "Force Any Triple: " .. tostring(state.anyTrible)
    elseif choix == 7 then
        state.trible = not state.trible
        setPatch(Dealer, "isTrible", state.trible, "bool", true)
        state.status = "Force Triple: " .. tostring(state.trible)
    elseif choix == 8 then
        state.double = not state.double
        setPatch(Dealer, "isDouble", state.double, "bool", true)
        state.status = "Force Double: " .. tostring(state.double)
    end
end
)";

// Hàm tự khởi chạy khi dylib được load vào game
__attribute__((constructor)) void initLuaEmbedded() {
    dispatch_async(dispatch_get_main_queue(), ^{
        lua_State *L = luaL_newstate();
        luaL_openlibs(L);
        
        if (luaL_dostring(L, embeddedLuaScript) != LUA_OK) {
            const char *errMsg = lua_tostring(L, -1);
            NSLog(@"[Lua Error] %s", errMsg);
            lua_pop(L, 1);
        }
        
        lua_close(L);
    });
}
