#import <Foundation/Foundation.h>
#import <UIKit/UIKit.h>

__attribute__((constructor)) void initNativeMod() {
    dispatch_async(dispatch_get_main_queue(), ^{
        NSLog(@"[SicBoMod] Dylib đã được inject thành công!");
        
        // Gọi phương thức load của PubgLoad (khởi tạo Menu Overlay)
        Class pubgLoadClass = NSClassFromString(@"PubgLoad");
        if (pubgLoadClass && [pubgLoadClass respondsToSelector:@selector(load)]) {
            [pubgLoadClass performSelector:@selector(load)];
            NSLog(@"[SicBoMod] Đã kích hoạt PubgLoad thành công!");
        } else {
            NSLog(@"[SicBoMod] Không tìm thấy lớp PubgLoad.");
        }
    });
}
